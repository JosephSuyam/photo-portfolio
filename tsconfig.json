{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleDetection": "legacy",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "rootDir": "src/portfolio/ts",
    "outDir": ".tmp/ts"
  },
  "include": ["src/portfolio/ts/**/*.ts"]
}
