# Path to the service-account JSON key (keep it outside the repo)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# ID of the portfolio root folder (the last part of its Drive URL)
DRIVE_ROOT_FOLDER_ID=
SITE_TITLE=My Portfolio
SITE_BASE_URL=http://localhost:8000
# Optional https:// endpoint of a form service; adds a message form to the Contact page
# (see docs/setup.md). Uncomment and replace the placeholder with your own endpoint.
# CONTACT_FORM_URL=https://formspree.io/f/your-form-id
